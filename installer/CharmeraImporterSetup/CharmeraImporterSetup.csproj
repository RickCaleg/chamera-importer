<Project Sdk="Microsoft.NET.Sdk">
  <!--
    A tiny, dependency-free Windows installer for Charmera Importer, built because the
    usual native-installer toolchains (WiX, NSIS) either require Windows to build or are
    broken when run under Linux (WiX's own CLI explicitly warns it only supports Windows,
    and its Directory Name path validation is in fact broken cross-platform as of v5/v6,
    confirmed while working on this project). This ships as one self-contained win-x64 exe
    with the real app embedded as a resource; see Program.cs for what it actually does.

    Build: dotnet publish -c Release -r win-x64 -p:PublishSingleFile=true
             -p:AppExePath=(path to the published charmera-importer.exe)
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <AssemblyName>CharmeraImporterSetup</AssemblyName>
    <RootNamespace>CharmeraImporterSetup</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationIcon>..\..\charmera-importer\Assets\charmera-icon.ico</ApplicationIcon>
    <Version>0.1.0</Version>
    <Product>Charmera Importer Setup</Product>
    <!-- Only ever meant to be cross-published for win-x64; building/running it on Linux
         (e.g. `dotnet build` with no -r) is not a supported/tested path. -->
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AppExePath Condition="'$(AppExePath)' == ''">..\..\..\publish-staging\windows\charmera-importer.exe</AppExePath>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(AppExePath)">
      <LogicalName>charmera-importer.exe</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
